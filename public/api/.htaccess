# [v1.26.0] Neutralizza la cache statica ereditata dalla configurazione DreamHost.
#
# PROBLEMA: le risposte di /api/*.php arrivavano al browser con DUE header
# Cache-Control — quello corretto emesso dal PHP (no-store, v1.25.0) e un
# "max-age=172800" (2 giorni) accompagnato da un "Expires" a +2 giorni.
# Nessuno dei due viene dal repo: sono iniettati da una configurazione a monte
# della docroot (un .htaccess nella home dell'utente SFTP e/o mod_expires
# attivato dal pannello). Verificato con curl su navigation.php il 12/08/2026.
#
# no-store vince comunque nei browser, ma la coppia contraddittoria confonde
# proxy e strumenti diagnostici. Le direttive di una .htaccess figlia vengono
# applicate DOPO quelle ereditate, quindi qui possiamo ripulire.
#
# Ogni endpoint sotto /api/ è dinamico e dipende dalla sessione: no-store è
# la semantica corretta per tutti, nessuno escluso.

<IfModule mod_expires.c>
  # Impedisce a mod_expires di calcolare Expires/max-age per questa directory
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
  # "always" agisce sulla tabella err_headers_out, dove finiscono gli header
  # impostati con "Header always set" a monte: senza questo la riga duplicata
  # sopravvive anche con ExpiresActive Off.
  Header always unset Cache-Control
  Header always unset Expires
  Header unset Expires

  # Riemette il valore corretto una volta sola, a valle di ogni unset.
  Header set Cache-Control "no-store, no-cache, must-revalidate"

  # [v1.27.2] Gli endpoint fuori dall'indice, senza passare da robots.txt.
  #
  # Il nostro robots.php contiene "Disallow: /api/", ma NON viene mai servito:
  # /robots.txt è intercettato dall'infrastruttura DreamHost prima di arrivare
  # ad Apache, e il file imposto non blocca /api/ (verificato il 12/08/2026 —
  # /robots.TXT maiuscolo serve il nostro, /robots.txt minuscolo no).
  # X-Robots-Tag ottiene lo stesso risultato per via diretta, senza dipendere
  # da un file che non controlliamo: i crawler ricevono l'istruzione nella
  # risposta stessa e non indicizzano le risposte JSON.
  #
  # Solo "noindex", MAI "nofollow": /api/rss.php è il feed RSS, e nofollow
  # impedirebbe di seguire i link agli articoli nuovi.
  Header set X-Robots-Tag "noindex"
</IfModule>
