# [v1.6.0] Upload size limits per file di grandi dimensioni (ZIP, archivi)

<IfModule mod_php.c>
  php_value upload_max_filesize 256M
  php_value post_max_size 256M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>

# [v2.0] Forza Apache a eseguire index.php (SEO Engine) prima di index.html
# (index.html resta in elenco per le cartelle che sono siti a sé, come relitto/)
DirectoryIndex index.php index.html

# [16/10/2026] Le regole di casa di FDCA (revisione del 16 ottobre, M1).
#
# Fino a oggi /lib/, /api/, /pages/, /partials/, /images/ e /assets/ rispondevano
# con «Index of …» e l'elenco dei file: chiunque vedeva il nome di ogni libreria
# e di ogni vecchia API. E /partials/head.php o /pages/home.php, chiamati
# direttamente, si eseguivano e rispondevano 500.
Options -Indexes

# File che non devono mai uscire, dovunque siano: database, chiavi, copie,
# dump, log, i backup interrotti a metà.
<FilesMatch "\.(sqlite|sqlite3|db|bak|key|sql|gz|log|parziale|md)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

# [v1.19.0] Forza HTTPS: ogni richiesta in chiaro viene redirezionata (301)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# [16/10/2026] Le cartelle del codice non sono pagine: si includono, non si
# chiedono. Da fuori rispondono 404, come in FDCA.
  RewriteRule ^(lib|pages|partials)(/|$) - [R=404,L]

# [v2.0] SEO Files — SEMPRE serviti da PHP (contenuto dinamico real-time)
# Questo elimina il bug v1.9.6 del 404 sporadico su robots.txt e garantisce
# che la sitemap sia sempre aggiornata senza bisogno di prerendering manuale.
  RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]
  RewriteRule ^robots\.txt$ robots.php [L,NC]

# I file veri (immagini, endpoint, CSS, JS, caratteri) e le cartelle vere
# (/admin/) si servono come sono. Tutto il resto va al front controller, che
# dal 07/09/2026 è il sito in PHP: non c'è più un guscio React da riempire,
# né una versione diversa della pagina per i crawler.

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/ [NC]

  RewriteRule ^(.*)$ /index.php [L,QSA]
</IfModule>


# [v1.7.3] Redirect 301 Permanenti — URL articoli riorganizzati
# Aggiungere qui ogni volta che una URL pubblica di un articolo cambia struttura.
# IMPORTANTE: non cambiare URL già pubblicate senza aggiungere il redirect corrispondente.
# Questo protegge SEO, bookmark degli utenti e sistemi di integrazione (es. bot Telegram).
# Formato: Redirect 301 /vecchio-path /nuovo-path
#
# Esempio:
#   Redirect 301 /articoli/il-mio-articolo /narrativa-e-pubblicazioni/il-mio-articolo
#
# (Aggiungere i redirect specifici sotto questa riga quando necessario)

# [16/10/2026] La sitemap si rigenera a ogni richiesta, ma la configurazione di
# DreamHost a monte le appendeva «max-age=172800» ed Expires a due giorni,
# accanto all'ora che manda sitemap.php: due istruzioni contraddittorie
# (revisione del 16 ottobre, M11). Si toglie quella a monte come in api/.htaccess.
<Files "sitemap.php">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header always unset Cache-Control
    Header always unset Expires
    Header unset Expires
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>

# [v1.23.0] Vecchie categorie della struttura pre-categorie (gen 2026) ancora
# nell'indice Google come 404. Redirect SOLO esatto (no sotto-path: gli articoli
# di quella vecchia struttura sono stati rimossi e devono dare 404 reale via index.php).
RedirectMatch 301 ^/software/?$ /progetti-software
RedirectMatch 301 ^/libri/?$ /narrativa-e-pubblicazioni

# [v1.5.10] Security Headers

<IfModule mod_headers.c>

# Impedisce MIME-type sniffing (es. eseguire un file .jpg come script)

  Header always set X-Content-Type-Options "nosniff"

# [v1.19.0] HSTS: i browser ricordano per 1 anno di usare solo HTTPS
# (inviato solo su connessioni HTTPS, come da specifica)

  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

# Blocca il sito nell'essere caricato in iframe da altri domini (Clickjacking)

  Header always set X-Frame-Options "SAMEORIGIN"

# Limita le informazioni di referrer inviate a siti terzi

  Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Disabilita API hardware non necessarie (camera, microfono, geolocalizzazione)

  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# Content Security Policy

# script-src 'self': solo bundle Vite locali (nessun inline script in produzione)

# style-src 'self' 'unsafe-inline' fonts.googleapis.com: CSS Vite + inline style="" usati da Framer Motion + Google Fonts CSS

# font-src 'self' data: fonts.gstatic.com: font locali + Google Fonts binari (woff2)

# img-src 'self' data: https:: immagini locali + data URI + immagini esterne (cover articoli CDN)

# connect-src 'self': chiamate API solo verso stesso dominio

# object-src 'none': blocca plugin Flash/PDF embed (vettore attacco legacy)

# frame-ancestors 'self': equivale a X-Frame-Options SAMEORIGIN ma per browser moderni

# [07/09/2026] La CSP non si manda più da qui.
#
# Il sito nuovo usa un nonce — un numero diverso a ogni richiesta — per
# ammettere i pochi script scritti dentro la pagina (i dati strutturati, il
# grafico del pannello) senza aprire la porta a 'unsafe-inline'. Un nonce lo
# può generare solo PHP: un file di configurazione non cambia a ogni
# richiesta. La manda partials/head.php, e `Header always set` qui vincerebbe
# su quella, quindi questa riga resta commentata.
#
# Se un giorno il PHP dovesse smettere di mandarla, la rete di sicurezza è
# ripristinare la riga qui sotto: è la CSP del sito vecchio, senza nonce.
#
#  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self'; object-src 'none'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'self'; base-uri 'self'"

# [16/10/2026] La CSP vera del sito (revisione del 16 ottobre, G2).
#
# La configurazione di DreamHost a monte manda una sua CSP e sostituisce quella
# che manda PHP: per questo la riga sta qui. Le prime due righe tolgono quella
# a monte (e, per forza, anche quella di PHP, che è identica: CSP_SITO in
# lib/avvio.php); la terza mette la nostra. Se si cambia qui, si cambia là.
#
# Dal 3 al 16 ottobre qui c'era 'unsafe-inline' negli script, per tre <script>
# in linea del pannello che adesso stanno in assets/js/admin.js. Senza
# 'unsafe-inline' uno script finito in pagina per sbaglio non parte.
#
# relitto/ e temp/ sono siti a sé, con i loro file e le loro regole: tengono la
# politica che avevano dal 3 ottobre (relitto carica i caratteri da Google).
# Non si toccano i loro file: la distinzione si fa qui, per indirizzo.
    SetEnvIf Request_URI "^/(relitto|temp)/" SITO_OSPITE
    Header always unset Content-Security-Policy
    Header unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" env=!SITO_OSPITE
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self'; object-src 'none'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'self'; base-uri 'self'" env=SITO_OSPITE

</IfModule>
